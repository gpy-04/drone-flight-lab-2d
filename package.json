{
  "name": "drone-flight-lab-2d",
  "version": "3.0.0",
  "private": true,
  "description": "Eight 2D drone science and urban airspace games for ages 10–14",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node serve.mjs",
    "test": "node v3-model-check.mjs && node v3-browser-check.mjs",
    "test:offline": "node v3-browser-check.mjs --built",
    "test:science": "node v3-science-check.mjs",
    "test:smoke": "node v3-browser-check.mjs --smoke",
    "test:visual": "node v3-browser-check.mjs --visual",
    "test:practice": "node v3-browser-check.mjs --practice",
    "test:demos": "node v3-browser-check.mjs --demos",
    "test:media": "node v3-media-check.mjs"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "engines": {
    "node": ">=22"
  }
}
